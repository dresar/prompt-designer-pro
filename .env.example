# PromptStudio AI — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# ─── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET="change-me-to-a-random-64-char-secret"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Encryption (for API keys stored in DB) ───────────────────────────────────
# Must be exactly 32 characters
ENCRYPTION_SECRET="change-me-32-char-secret-12345678"

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
APP_URL="http://localhost:3001"

# ─── CORS (comma-separated origins) ──────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://yourdomain.vercel.app"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"
RATE_LIMIT_AUTH_MAX="10"

# ─── Redis (optional — falls back to in-memory cache) ────────────────────────
# REDIS_URL="redis://localhost:6379"
# REDIS_URL="rediss://your-redis-url:6380" # for TLS

# ─── Cloudinary (optional — falls back to local storage) ─────────────────────
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# ─── AI (Gemini + Groq API keys are stored in database via Admin Panel) ───────
# These are NOT needed here — add them through the Admin Panel
AI_TIMEOUT_MS="30000"
AI_MAX_RETRIES="3"
AI_RETRY_DELAY_MS="1000"

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB="5"
UPLOAD_DIR="uploads"

# ─── Security ─────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION_SECONDS="900"
BCRYPT_SALT_ROUNDS="12"

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
LOG_SILENT="false"

# ─── Vercel (set automatically by Vercel) ─────────────────────────────────────
# VERCEL="1"
